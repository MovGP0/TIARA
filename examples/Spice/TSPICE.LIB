+       tswhl2=1.5ns		tswlh2=1.5ns
+       tswhl3=1.5ns		tswlh3=1.5ns
+       tswhl4=1.5ns		tswlh4=1.5ns
+	DIGPOWER="DIGIFPWR"
+	)
*$
