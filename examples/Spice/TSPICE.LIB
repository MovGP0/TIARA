********************************************
**  TINA device library                   **
**  (c) 2008 DesignSoft, Inc.             **
********************************************
*
.SUBCKT PotMeter A B C PARAMS: Res=1, Percent=1
R1 A C {Res * Percent}
R2 B C {Res * (1-Percent)}
.ENDS
*
****  Microstrip Model
.SUBCKT	Microstrip  1  2  Params: W=100u L=1m H=100u ER=1
.Param  c = 3e8
.Param  wdbh = {W/H}
.Param  hdbw = {H/W}
.Param  eeff = {(ER + 1)/2 + (ER - 1)/(2 * sqrt(1 + 10 * hdbw))}
.Param  z01 =  {if (wdbh <= 1, 60*log(8*hdbw + 0.25*wdbh), 120*pi/(wdbh + 2.42 - 0.44*hdbw + pwr((1 - hdbw), 6)))}
.Param  WaveImp = {z01/sqrt(eeff)}
.Param  Delay = {L * sqrt(eeff)/c}
TL1   1 0 2 0  Z0={WaveImp} TD={Delay}       
.ENDS

****  Microstrip Open End Model
.SUBCKT	Microstrip_Open  1  Params: W=100u L=1m H=100u ER=1
X1   1 2  Microstrip  Params: W={W} L={L} H={H} ER={ER} 
R2   2 0 1T   
.ENDS

****  Microstrip Shorted Model
.SUBCKT	Microstrip_Shorted  1  Params: W=100u L=1m H=100u ER=1
X1   1 0  Microstrip  Params: W={W} L={L} H={H} ER={ER} 
R2   2 0 1T   
.ENDS
*
* TTL/CMOS power supply
*
.subckt DIGIFPWR  AGND
+	optional: DPWR=$G_DPWR DGND=$G_DGND
+	params:   VOLTAGE=5.0v REFERENCE=0v
*
VDPWR  DPWR0 DGND0  {VOLTAGE}
RDPWR  DPWR0 DPWR  1m
CDPWR  DPWR0 DPWR  100
R1     DPWR AGND  1MEG
VDGND  DGND0 AGND  {REFERENCE}
RDGND  DGND0 DGND  1m
*CDGND  DGND0 DGND  100
CDGND  AGND DGND  100
*RDGND  DGND0 DGND  100u
R2     DGND AGND  1MEG
.ends

*
* CD4000 CMOS power supply
*
.param CD4000_VDD 5.0V
.param CD4000_VSS 0.0V

.subckt CD4000_PWR  AGND
+	optional: VDD=$G_CD4000_VDD VSS=$G_CD4000_VSS
+	params:   VOLTAGE={CD4000_VDD} REFERENCE={CD4000_VSS}
*
VVDD  VDD VSS   {VOLTAGE}
R1    VDD AGND  1MEG
VVSS  VSS AGND  {REFERENCE}
R2    VSS AGND  1MEG
.ends
*$

* 7400 I/O Models

*$
.model IO_STD_o uio (
+	drvh=96.4	drvl=104
+	AtoD1="AtoD_STD"	AtoD2="AtoD_STD_NX"
+	AtoD3="AtoD_STD"	AtoD4="AtoD_STD_NX"
+	DtoA1="DtoA_STD"	DtoA2="DtoA_STD"
+	DtoA3="DtoA_STD"	DtoA4="DtoA_STD"
+       tswhl1=1.511ns		tswlh1=3.517ns
+       tswhl2=1.487ns		tswlh2=3.564ns
+       tswhl3=1.511ns		tswlh3=3.517ns
+       tswhl4=1.487ns		tswlh4=3.564ns
+	DIGPOWER="DIGIFPWR"
+	)
*$
.model IO_STD uio (
+	drvh=100	drvl=100
+	AtoD1="AtoD_STD"	AtoD2="AtoD_STD_NX"
+	AtoD3="AtoD_STD"	AtoD4="AtoD_STD_NX"
+	DtoA1="DtoA_STD"	DtoA2="DtoA_STD"
+	DtoA3="DtoA_STD"	DtoA4="DtoA_STD"
