function Test1(t);
begin
  s := 0;
  For i := 1 To t Do
   s := s+i;
  Test1 := s;
end;

function Test2(t);
begin
  s := 0;
  i := 0;
  While i <= t Do Begin
   s := s+i;
   i:=i+1;
  End;
  Test2 := s;
end;

Test1(5)=[15]
Test2(5)=[15]



