Function Con1(t);
Begin
 Con1 := sin(t);
End;

Function Con(t);
Begin
 Con := Integ(sin(t),0,t,t);
End;

Draw(Con1(x),a1)
Draw(Con(x),a2)
Draw(Integ(Con1(x),0,x,x),a3)



