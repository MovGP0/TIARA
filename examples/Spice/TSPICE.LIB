.ENDS D_D
*$
.SUBCKT HYSTCOMP_0  INP INM OUT GND 
+ PARAMS: VTHRES=0 VHYST=1 VOUTH=5 VOUTL=0 ROUT=1 TDEL=1N
*
.PARAM RDEL = {IF ( (TDEL > 1E-15) & (ROUT < 1), 1, ROUT ) } 
.PARAM VOUTM={(VOUTH+VOUTL)/2}
.PARAM VTHH={VTHRES+VHYST}
.PARAM VTHL={VTHRES-VHYST}
.PARAM COUT={TDEL/(0.693*(RDEL+1U))}
*
ETHR THR GND VALUE= { IF ( V(OUT,GND) < {VOUTM}, {VTHH}, {VTHL}) }
EOUT OUT GND VALUE= { IF ( V(INP,INM) > V(THR,GND), VOUTH + RDEL*I(EOUT) , VOUTL + RDEL*I(EOUT)  ) }
COUT OUT GND {COUT}
.ENDS
*$
.SUBCKT HYSTCOMP_EN inp inm en out gnd 
+ Params: Vthres=0 Vhyst=1 VoutH=5 VoutL=0 Rout=1 Tdel=1N Venthres=0.5
*
.Param Rdel = {IF ( (Tdel > 1E-15) & (Rout < 1), 1, Rout ) } 
.Param VoutM={(VoutH+VoutL)/2}
.Param VthH={Vthres+Vhyst}
.Param VthL={Vthres-Vhyst}
.Param Cout={Tdel/(0.693*(Rdel+1u))}
*
Ethr thr gnd Value= { IF ( V(out,gnd) < {VoutM}, {VthH}, {VthL}) }
Eout out gnd Value= { IF ( (V(inp,inm) > V(thr,gnd)) | (V(en,gnd) < Venthres) , VoutH + Rdel*I(Eout) , VoutL + Rdel*I(Eout)  ) }
Cout out gnd {Cout}
.ENDS
*$
.SUBCKT Q_NMOS  D G S PARAMS: M=1 W=10U L=2U
*            D G S
MNI1 D G S S Q_NMOS M={M} L={L} W={W}
.ENDS
*$
.SUBCKT Q_PMOS  D G S PARAMS: M=1 W=10U L=2U
*            D G S
MPI1 D G S S Q_PMOS M={M} L={L} W={W}
.ENDS
*$
.SUBCKT VOST_1   1 2 ACM
*OFFSET VOLTAGE, RTI(1) VOS VSENSE = 0MV ±20 ±70 UV
*VS TEMPERATURE DVOS/DT ±0.3 ±1.5 UV/°C
.PARAM I0 = 1M
.PARAM DVOS_DT= {0.3U*5/6}
.PARAM VOFFS = {20U*5/6 + 2*DVOS_DT}
.PARAM R0 = {VOFFS/I0}
.PARAM TC1= {DVOS_DT/R0/I0}

R2 40 0 RMOD2 {R0}
I2 40 0 {I0}
*E3 1 2 40 0 1
E3 1 2 VALUE = {IF (V(ACM,0) > 0.5, V(40), V(40)-10.8U)}
.MODEL RMOD2 RES (TC1={TC1} TC2=0 TCE=0)
.ENDS

*$
.SUBCKT Q_PMOS_OUT_L1_0   D G S B PARAMS:  M = 1 W = 100U L = 10U
M1 D G S B Q_PMOS_OUT_L1 W = {W} L = {L} M = {M} AD={W*LS} AS={W*LS} PD={W + 2*LS} PS={W + 2*LS} 
+ NRD={LS/W} NRS={LS/W}
.ENDS
*$
.SUBCKT Q_PMOS_OUT_0   D G S B PARAMS:  M = 1 W = 100U L = 10U
M1 D G S B Q_PMOS_OUT W = {W} L = {L} M = {M} AD={W*LS} AS={W*LS} PD={W + 2*LS} PS={W + 2*LS} 
+ NRD={LS/W} NRS={LS/W}
.ENDS
*$
.SUBCKT Q_NMOS_OUT_0   D G S B PARAMS:  M = 1 W = 100U L = 10U
M1 D G S B Q_NMOS_OUT  W = {W} L = {L} M = {M} AD={W*LS} AS={W*LS} PD={W + 2*LS} PS={W + 2*LS} 
+ NRD={LS/W} NRS={LS/W}
.ENDS
*$
.SUBCKT Q_NMOS_OUT_L1_0   D G S B PARAMS:  M = 1 W = 100U L = 10U
M1 D G S B Q_NMOS_OUT_L1  W = {W} L = {L} M = {M} AD={W*LS} AS={W*LS} PD={W + 2*LS} PS={W + 2*LS} 
+ NRD={LS/W} NRS={LS/W}
.ENDS
*$

*PARAMETERS: 0.4UM CMOS
.PARAM LS = 1.0U
.PARAM VTOHP = 0.70
.PARAM VTOHN = 0.70
.PARAM LAMBDA = 100M
.PARAM LAMBDAP = 100M
.PARAM LAMBDAN = 100M
.PARAM GAMMA = 0.0
.PARAM KAPPA = 1.0
.PARAM THETA = 0.1
.PARAM ETA = 0.05
.PARAM PHI = 0.6
.PARAM EPSSIO2 = {3.9*8.854214871E-12}
.PARAM TOX = 80E-10
.PARAM COX = {EPSSIO2/TOX}
.PARAM KPN = {UON*COX * 1E-4}
.PARAM KPP = {UOP*COX * 1E-4}
.PARAM LDN = 0.09U
.PARAM LDP = 0.09U
.PARAM RSW = 1810
.PARAM RSN = 1.41
.PARAM RSH = 4.0
*.PARAM RDS = 2.25MEG
.PARAM RDS = 1.8MEG
.PARAM VBMUL = 1E6
.PARAM RPAR = 1T
.PARAM CBDJ = 1.0 
.PARAM CBDS = 1.0
.PARAM CGBF = 1.0
.PARAM PBP = 0.7
.PARAM PBN = 0.7
.PARAM UON = 900
.PARAM UOP = 900
.PARAM CJN = {200U}
.PARAM CJP = {400U} 
.PARAM CJSWN = {1.2N}
.PARAM CJSWP = {2.4N}
.PARAM XJN = 0.15U
.PARAM CGSON = {0.6*XJN*COX} 
.PARAM CGDON = {CGSON}
.PARAM CGBON = {CGBF*CGDON}
.PARAM XJP = 0.18U
.PARAM CGSOP = {0.6*XJP*COX} 
.PARAM CGDOP = {CGSOP}
.PARAM CGBOP = {CGBF*CGDOP}
