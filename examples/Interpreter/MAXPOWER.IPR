{ Load IPR\MAXPOWER.SCH before running this }
Function PowerR3(R3);
Begin
   PowerR3 := Sqr(Us)*Sqr(R2)*R3/Sqr(R1*R2+R1*R3+R2*R3);
End;

Draw( PowerR3(R3), P )





